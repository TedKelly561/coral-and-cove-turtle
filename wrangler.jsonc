{
  // Cloudflare hosting: serves the built game (dist/) as a static site.
  "$schema": "https://unpkg.com/wrangler@4/config-schema.json",
  "name": "coral-cove",
  "compatibility_date": "2026-11-13",
  // Build the game before every deploy, so hosting works even if no build
  // command is set in the Cloudflare dashboard.
  "build": {
    "command": "npm run build"
  },
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
