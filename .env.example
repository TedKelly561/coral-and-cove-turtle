# Copy this file to .env.local and fill in the values. .env.local is git-ignored.
# Never commit real values.
#
# These enable the optional "Google Drive Saves & Postcards" feature.
# Without them the game runs normally and Drive saves are simply switched off.
# Find them in the Firebase console: Project settings > General > Your apps > Web app.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
